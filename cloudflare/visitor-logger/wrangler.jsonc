{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matspoems-visitor-logger",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "matspoems.com/*",
      "zone_name": "matspoems.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "VISITOR_DB",
      "database_name": "matspoems-visitors",
      "database_id": "a29e9084-0f0b-4035-8a93-19dde59260ae"
    }
  ],
  "vars": {
    "RETENTION_DAYS": "30"
  },
  "triggers": {
    "crons": ["17 4 * * *"]
  }
}
